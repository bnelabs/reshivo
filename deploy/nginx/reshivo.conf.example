# Install inside the nginx http context (e.g. sites-enabled). Replace the domain
# and certificate paths before enabling. Keep the map at http level.
map $http_origin $reshivo_origin {
    default "https://invalid-origin.invalid";
    "" "";
    "https://RESHIVO_DOMAIN" "http://127.0.0.1:8797";
}

server {
    listen 443 ssl;
    server_name RESHIVO_DOMAIN;
    ssl_certificate /etc/letsencrypt/live/RESHIVO_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/RESHIVO_DOMAIN/privkey.pem;

    if ($host != RESHIVO_DOMAIN) { return 444; }
    auth_basic "Reshivo";
    auth_basic_user_file /etc/reshivo/htpasswd;
    client_max_body_size 4m;

    location / {
        proxy_pass http://127.0.0.1:8797;
        proxy_http_version 1.1;
        proxy_set_header Host "127.0.0.1:8797";
        # Never turn an arbitrary browser Origin into a trusted local Origin.
        proxy_set_header Origin $reshivo_origin;
        proxy_set_header Authorization "";
        proxy_read_timeout 150s;
        proxy_connect_timeout 5s;
    }
}
