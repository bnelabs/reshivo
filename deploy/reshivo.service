[Unit]
Description=Reshivo local application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=reshivo
Group=reshivo
WorkingDirectory=/opt/reshivo
EnvironmentFile=-/etc/reshivo/reshivo.env
ExecStart=/opt/reshivo/.venv/bin/python -m rematter serve --port 8797
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/reshivo

[Install]
WantedBy=multi-user.target
